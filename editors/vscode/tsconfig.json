{
	"compilerOptions": {
		"module": "preserve",
		"moduleResolution": "bundler",
		"target": "ES2023",
		"lib": ["ES2023"],
		"types": ["node", "vscode"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["src", "test"]
}
