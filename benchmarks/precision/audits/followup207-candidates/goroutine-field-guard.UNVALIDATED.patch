+// Repeated receiver predicates express the same uncertain launch/join
+// correlation as local flags. Matching addresses does not prove stable field
+// contents: opaque mutation is an intentional coverage gap, while explicit
+// writes reject this boundary. This remains Unknown, never a guaranteed join.
+// https://github.com/Shopify/ghostferry/blob/317547432f785fb77a0d10fbca12d8af40e39fd3/ferry.go#L726-L772
+func (analysis *spawnAnalysis) repeatedFieldGuard(join *ssa.If) bool {
+	block := analysis.spawn.Block()
+	if len(block.Preds) != 1 || !ssaflow.InstructionMayFollow(analysis.spawn, join) {
+		return false
+	}
+	predecessor := block.Preds[0]
+	launch, ok := predecessor.Instrs[len(predecessor.Instrs)-1].(*ssa.If)
+	if !ok {
+		return false
+	}
+	left, launchOp := nilComparedField(launch.Cond)
+	right, joinOp := nilComparedField(join.Cond)
+	if left == nil || right == nil || launchOp != joinOp || left.Field != right.Field {
+		return false
+	}
+	storage := ssaflow.NewStorage(ssaflow.NewSearchBudget(1000))
+	if !storage.Same(left.X, right.X).Proven() || analysis.fieldWrittenBetween(left, launch, join) {
+		return false
+	}
+	index := 0
+	if predecessor.Succs[0] != block {
+		index = 1
+	}
+	for _, instruction := range join.Block().Succs[index].Instrs {
+		// Only ordinary calls and receives can provide this exact join.
+		// Do not recursively classify successor guards while classifying one.
+		switch instruction.(type) {
+		case *ssa.Call, *ssa.UnOp:
+		default:
+			continue
+		}
+		if analysis.action(instruction) == actionJoin {
+			return true
+		}
+	}
+	return false
+}
+
+func nilComparedField(condition ssa.Value) (*ssa.FieldAddr, token.Token) {
+	comparison, ok := condition.(*ssa.BinOp)
+	if !ok || (comparison.Op != token.EQL && comparison.Op != token.NEQ) {
+		return nil, token.ILLEGAL
+	}
+	value := comparison.X
+	if ssaflow.DefinitelyNil(value) {
+		value = comparison.Y
+	} else if !ssaflow.DefinitelyNil(comparison.Y) {
+		return nil, token.ILLEGAL
+	}
+	load, ok := value.(*ssa.UnOp)
+	if !ok || load.Op != token.MUL {
+		return nil, token.ILLEGAL
+	}
+	field, _ := load.X.(*ssa.FieldAddr)
+	return field, comparison.Op
+}
+
+func (analysis *spawnAnalysis) fieldWrittenBetween(field *ssa.FieldAddr, launch, join *ssa.If) bool {
+	for _, store := range ssaflow.InstructionsOf[*ssa.Store](analysis.function) {
+		// A possibly aliasing receiver write also rejects the correlation;
+		// failure to prove receiver identity is not proof of disjoint storage.
+		if writesGuardedField(store, field) &&
+			ssaflow.InstructionMayFollow(launch, store) && ssaflow.InstructionMayFollow(store, join) {
+			return true
+		}
+	}
+	worker, _ := spawnedFunction(analysis.pass, analysis.spawn)
+	for _, store := range ssaflow.InstructionsOf[*ssa.Store](worker) {
+		if writesGuardedField(store, field) {
+			return true
+		}
+	}
+	return false
+}
+
+func writesGuardedField(store *ssa.Store, field *ssa.FieldAddr) bool {
+	if types.Identical(store.Addr.Type(), field.X.Type()) {
+		return true // Replacing the whole receiver also replaces the field.
+	}
+	written, ok := store.Addr.(*ssa.FieldAddr)
+	return ok && written.Field == field.Field && types.Identical(written.X.Type(), field.X.Type())
+}
