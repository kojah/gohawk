+package goroutineownership
+
+import "sync"
+
+// Repeated receiver predicates correlate launch and join without proving that
+// the receiver is immutable. An opaque intervening mutation remains an
+// intentional coverage gap; explicit replacement must retain the diagnostic.
+type workerFields struct {
+	enabled *int
+	other   *int
+}
+
+func repeatedReceiverFieldGuard(owner *workerFields) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		group.Add(1)
+		go func() { defer group.Done(); _ = owner.enabled }()
+	}
+	if owner.enabled != nil {
+		group.Wait()
+	}
+}
+
+func siblingReceiverFieldGuard(owner *workerFields) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		group.Add(1)
+		go func() { defer group.Done(); _ = owner.enabled }() // want "goroutine is not joined on every return path"
+	}
+	if owner.other != nil {
+		group.Wait()
+	}
+}
+
+func differentReceiverFieldGuard(owner, other *workerFields) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		group.Add(1)
+		go func() { defer group.Done(); _ = owner.enabled }() // want "goroutine is not joined on every return path"
+	}
+	if other.enabled != nil {
+		group.Wait()
+	}
+}
+
+func oppositeReceiverFieldGuard(owner *workerFields) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		group.Add(1)
+		go func() { defer group.Done(); _ = owner.enabled }() // want "goroutine is not joined on every return path"
+	}
+	if owner.enabled == nil {
+		group.Wait()
+	}
+}
+
+func replacedReceiverFieldGuard(owner *workerFields) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		group.Add(1)
+		go func() { defer group.Done(); _ = owner.enabled }() // want "goroutine is not joined on every return path"
+	}
+	owner.enabled = nil
+	if owner.enabled != nil {
+		group.Wait()
+	}
+}
+
+func replacedFieldBeforeSpawn(owner *workerFields) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		owner.enabled = nil
+		group.Add(1)
+		go func() { defer group.Done(); _ = owner.enabled }() // want "goroutine is not joined on every return path"
+	}
+	if owner.enabled != nil {
+		group.Wait()
+	}
+}
+
+func workerReplacesFieldGuard(owner *workerFields) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		group.Add(1)
+		go func() { defer group.Done(); owner.enabled = nil }() // want "goroutine is not joined on every return path"
+	}
+	if owner.enabled != nil {
+		group.Wait()
+	}
+}
+
+func replacedWholeReceiverGuard(owner *workerFields) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		group.Add(1)
+		go func() { defer group.Done(); _ = owner.enabled }() // want "goroutine is not joined on every return path"
+	}
+	*owner = workerFields{}
+	if owner.enabled != nil {
+		group.Wait()
+	}
+}
+
+func returnBeforeRepeatedFieldGuard(owner *workerFields, failed bool) {
+	var group sync.WaitGroup
+	if owner.enabled != nil {
+		group.Add(1)
+		go func() { defer group.Done(); _ = owner.enabled }() // want "goroutine is not joined on every return path"
+	}
+	if failed {
+		return
+	}
+	if owner.enabled != nil {
+		group.Wait()
+	}
+}
