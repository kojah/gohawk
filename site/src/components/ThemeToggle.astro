<gohawk-theme-toggle>
	<button type="button" role="switch" aria-checked="false" aria-label="Dark theme">
		<span class="switch-thumb" aria-hidden="true"></span>
	</button>
	<span class="theme-icon sun" aria-hidden="true">
		<svg viewBox="0 0 24 24">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path>
		</svg>
	</span>
	<span class="theme-icon moon" aria-hidden="true">
		<svg viewBox="0 0 24 24">
			<path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8a8.5 8.5 0 1 0 11.4 11.4Z"></path>
		</svg>
	</span>
</gohawk-theme-toggle>

<script>
	const storageKey = 'starlight-theme';
	type Theme = 'dark' | 'light';

	const systemTheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	function storedTheme(): Theme | undefined {
		const stored = localStorage.getItem(storageKey);
		return stored === 'light' || stored === 'dark' ? stored : undefined;
	}

	function updateToggles(theme: Theme): void {
		document.querySelectorAll<HTMLButtonElement>('gohawk-theme-toggle button').forEach((button) => {
			const isDark = theme === 'dark';
			button.setAttribute('aria-checked', String(isDark));
			button.title = `Switch to ${isDark ? 'light' : 'dark'} theme`;
		});
	}

	function applyTheme(theme: Theme, persist = false): void {
		document.documentElement.dataset.theme = theme;
		if (persist) localStorage.setItem(storageKey, theme);
		updateToggles(theme);
	}

	class GohawkThemeToggle extends HTMLElement {
		connectedCallback(): void {
			applyTheme(storedTheme() ?? systemTheme());
			const button = this.querySelector('button');
			const thumb = this.querySelector<HTMLElement>('.switch-thumb');
			button?.addEventListener('click', () => {
				const isDark = document.documentElement.dataset.theme === 'dark';
				const nextTheme = isDark ? 'light' : 'dark';
				thumb?.animate(
					[
						{ transform: `translateX(${isDark ? '1.1rem' : '0'})` },
						{ transform: `translateX(${nextTheme === 'dark' ? '1.1rem' : '0'})` },
					],
					{
						duration: 260,
						easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
					},
				);
				applyTheme(nextTheme, true);
			});
		}
	}

	if (!customElements.get('gohawk-theme-toggle')) {
		customElements.define('gohawk-theme-toggle', GohawkThemeToggle);
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (!storedTheme()) applyTheme(systemTheme());
	});
</script>

<style>
	gohawk-theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	button {
		position: relative;
		display: block;
		width: 2.5rem;
		height: 1.4rem;
		padding: 0;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 999px;
		background: var(--sl-color-gray-5);
		cursor: pointer;
		transition:
			background-color 220ms ease,
			border-color 220ms ease;
	}

	.switch-thumb {
		position: absolute;
		inset-block-start: 0.125rem;
		inset-inline-start: 0.125rem;
		display: block;
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 1px 3px rgb(0 0 0 / 28%);
		transition: transform 220ms cubic-bezier(0.25, 0.8, 0.25, 1);
		will-change: transform;
	}

	:global(html[data-theme='dark']) button {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
	}

	:global(html[data-theme='dark']) .switch-thumb {
		transform: translateX(1.1rem);
	}

	button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.theme-icon {
		display: inline-flex;
		color: var(--sl-color-white);
	}

	.theme-icon.moon {
		display: none;
	}

	.theme-icon svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 2;
	}

	:global(html[data-theme='dark']) .theme-icon.sun {
		display: none;
	}

	:global(html[data-theme='dark']) .theme-icon.moon {
		display: inline-flex;
	}
</style>
