---
interface Props {
	name: string;
	tier?: 'core' | 'extended' | 'experimental';
}

const { name, tier = 'core' } = Astro.props;
const selected = tier !== 'core';
---

<div class="check-identity">
	<span class="check-name">
		<code aria-label={selected ? `${name}, ${tier} check` : undefined} title={selected ? `${tier} check; requires selection` : undefined}>
			{name}
		</code>
	</span>
</div>

<style>
	.check-identity {
		display: flex;
		min-width: 0;
		align-items: flex-start;
	}

	.check-name {
		display: flex;
		max-width: 100%;
		align-items: flex-start;
		gap: 0.2rem;
	}

	code {
		max-width: 100%;
		font-size: var(--sl-text-xs);
		overflow-wrap: anywhere;
	}

</style>
