---
interface Props {
	name: string;
	optIn?: boolean;
}

const { name, optIn = false } = Astro.props;
---

<div class="check-identity">
	<span class="check-name">
		<code aria-label={optIn ? `${name}, opt-in check` : undefined} title={optIn ? 'Opt-in check' : undefined}>
			{name}{optIn ? '*' : ''}
		</code>
	</span>
</div>

<style>
	.check-identity {
		display: flex;
		min-width: 0;
		align-items: flex-start;
	}

	.check-name {
		display: flex;
		max-width: 100%;
		align-items: flex-start;
		gap: 0.2rem;
	}

	code {
		max-width: 100%;
		font-size: var(--sl-text-xs);
		overflow-wrap: anywhere;
	}

</style>
