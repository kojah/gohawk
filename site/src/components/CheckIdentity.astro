---
import CheckTags from './CheckTags.astro';

interface Props {
	name: string;
	optIn?: boolean;
	tags: string[];
}

const { name, optIn = false, tags } = Astro.props;
---

<div class="check-identity">
	<span class="check-name">
		<code>{name}</code>
		{optIn && <span class="opt-in" aria-label="opt-in" title="Opt-in check">*</span>}
	</span>
	<CheckTags tags={tags} />
</div>

<style>
	.check-identity {
		display: flex;
		min-width: 0;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
	}

	.check-name {
		display: flex;
		max-width: 100%;
		align-items: flex-start;
		gap: 0.2rem;
	}

	code {
		max-width: 100%;
		font-size: 0.82em;
		overflow-wrap: anywhere;
	}

	.opt-in {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		font-weight: 700;
		line-height: 1;
		color: var(--sl-color-accent-high);
	}
</style>
