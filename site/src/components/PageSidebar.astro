---
import DefaultPageSidebar from '@astrojs/starlight/components/PageSidebar.astro';

const { toc } = Astro.locals.starlightRoute;

// Starlight inserts the page title as a synthetic "Overview" entry. The title
// is already visible beside the table of contents, so start with real section
// headings on both desktop and mobile.
if (toc?.items[0]?.slug === '_top') {
	toc.items.shift();
}
---

<DefaultPageSidebar />
