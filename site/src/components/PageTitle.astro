---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import manifest from '../generated/analyzers.json';

const { entry } = Astro.locals.starlightRoute;
const analyzer = manifest.groups
	.flatMap((group) => group.analyzers.map((analyzer) => ({ ...analyzer, group: group.title })))
	.find((analyzer) => analyzer.path === entry.id);

// The landing page supplies its own title inside the hero, so suppress
// Starlight's; rendering both leaves the page with two <h1>s.
const isLanding = entry.id === 'index' || entry.id === '';

// A tier belongs to a check, not the analyzer, and an analyzer's checks can
// span tiers. Show the distinct set its checks use, most trusted first, so the
// header states them exactly instead of collapsing them to a single tier.
const tierOrder = ['core', 'extended', 'experimental'];
const tiers = analyzer
	? tierOrder.filter((tier) => analyzer.checks.some((check) => check.tier === tier))
	: [];
---

{
	analyzer ? (
		<div class="analyzer-header">
			<div class="analyzer-eyebrow">{analyzer.group}</div>
			<DefaultPageTitle />
			<p class="analyzer-summary">{analyzer.summary}</p>
			<div class="rule-meta">
				<div>
					<span class="rule-meta-label">{tiers.length > 1 ? 'Tiers' : 'Tier'}</span>
					<strong>{tiers.join(', ')}</strong>
				</div>
				<div>
					<span class="rule-meta-label">Fix offered</span>
					<strong>{analyzer.suggestedFix ? 'Yes' : 'No'}</strong>
				</div>
			</div>
		</div>
	) : (
		!isLanding && <DefaultPageTitle />
	)
}
