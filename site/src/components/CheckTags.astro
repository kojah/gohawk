---
import { Badge } from '@astrojs/starlight/components';

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
const variants = {
	correctness: 'danger',
	reliability: 'caution',
	policy: 'note',
} as const;
---

<span class="check-tags">
	{
		tags.map((tag) => (
			<a href={`../../../tags-and-profiles/#${tag}`}>
				<Badge
					text={tag}
					variant={variants[tag as keyof typeof variants] ?? 'default'}
					size="small"
				/>
			</a>
		))
	}
</span>

<style>
	.check-tags {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		vertical-align: top;
	}

	a {
		display: inline-flex;
		text-decoration: none;
	}

	.check-tags :global(.sl-badge) {
		font-size: 0.82em;
		overflow-wrap: normal;
		white-space: nowrap;
	}

	.check-tags :global(.sl-badge.caution) {
		--sl-color-border-badge: color-mix(
			in srgb,
			var(--sl-color-orange) 55%,
			var(--sl-color-hairline)
		);
		--sl-color-bg-badge: color-mix(
			in srgb,
			var(--sl-color-orange-low) 50%,
			var(--sl-color-bg)
		);
		--sl-color-text-badge: var(--sl-color-gray-1);
	}

	.check-tags :global(.sl-badge.danger) {
		--sl-color-border-badge: color-mix(
			in srgb,
			var(--sl-color-red) 55%,
			var(--sl-color-hairline)
		);
		--sl-color-bg-badge: color-mix(
			in srgb,
			var(--sl-color-red-low) 50%,
			var(--sl-color-bg)
		);
		--sl-color-text-badge: var(--sl-color-gray-1);
	}
</style>
