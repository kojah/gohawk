---
import { Badge } from '@astrojs/starlight/components';

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
const variants = {
	correctness: 'danger',
	reliability: 'caution',
	policy: 'note',
} as const;
---

<span class="check-tags">
	{
		tags.map((tag) => (
			<a href={`../../../tags-and-profiles/#${tag}`}>
				<Badge
					text={tag}
					variant={variants[tag as keyof typeof variants] ?? 'default'}
					size="small"
				/>
			</a>
		))
	}
</span>

<style>
	.check-tags {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		vertical-align: top;
	}

	a {
		display: inline-flex;
		text-decoration: none;
	}

	.check-tags :global(.sl-badge) {
		overflow-wrap: normal;
		white-space: nowrap;
	}
</style>
