---
import { Badge } from '@astrojs/starlight/components';

interface Props {
	profile: string;
}

const { profile } = Astro.props;
---

<span class="check-profile">
	<Badge
		text={profile}
		variant={profile === 'opt-in' ? 'caution' : 'success'}
		size="small"
	/>
</span>

<style>
	.check-profile {
		display: inline-flex;
		vertical-align: top;
	}

	.check-profile :global(.sl-badge) {
		overflow-wrap: normal;
		white-space: nowrap;
	}
</style>
