---
interface Props {
	profile: string;
}

const { profile } = Astro.props;
---

<span class="check-profile">{profile}</span>

<style>
	.check-profile {
		display: inline-block;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		white-space: nowrap;
		vertical-align: top;
	}
</style>
