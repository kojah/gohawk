---
const { entry, head } = Astro.locals.starlightRoute;
// Analyzer identifiers stay as the content title so navigation and the visible
// heading remain stable. seoTitle gives search and social previews the problem
// description a reader is more likely to recognize.
const seoTitle = 'seoTitle' in entry.data ? entry.data.seoTitle : undefined;
const pageHead = seoTitle
	? head.map((element) => {
			if (element.tag === 'title') {
				return { ...element, content: `${seoTitle} | gohawk` };
			}
			if (
				element.tag === 'meta' &&
				(element.attrs?.property === 'og:title' || element.attrs?.name === 'twitter:title')
			) {
				return { ...element, content: seoTitle };
			}
			return element;
		})
	: head;

const websiteSchema = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'gohawk',
	alternateName: 'Gohawk',
	url: new URL('/', Astro.site ?? Astro.url).href,
});
---

{pageHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

{
	Astro.url.pathname === '/' && (
		<script type="application/ld+json" set:html={websiteSchema} is:inline />
	)
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600..700&family=IBM+Plex+Mono:wght@400;600&family=Newsreader:opsz,wght@6..72,400..600&display=swap"
/>
