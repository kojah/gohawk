---
import PaginationFooter from './PaginationFooter.astro';
---

<PaginationFooter />
<script>
    if (import.meta.env.DEV) {
        const { mount, unmount } = await import('agentation-review/browser');
        mount();
        document.addEventListener('astro:page-load', mount);
        document.addEventListener('astro:before-swap', unmount);
        import.meta.hot?.dispose(() => {
            document.removeEventListener('astro:page-load', mount);
            document.removeEventListener('astro:before-swap', unmount);
            unmount();
        });
    }
</script>
