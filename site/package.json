{
	"name": "gohawk-docs",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "astro dev",
		"dev:review": "astro dev stop && agentation-review",
		"start": "astro dev",
		"generate": "go run ../tools/gendocs",
		"check": "go run ../tools/gendocs -check && biome check . && GOHAWK_ASTRO_CHECK=1 astro check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"build": "astro build && node scripts/check-sitemap.mjs",
		"lighthouse": "node scripts/run-unlighthouse.mjs",
		"lighthouse:production": "node scripts/run-unlighthouse.mjs --production",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@astrojs/starlight": "0.41.6",
		"@expressive-code/core": "0.44.1",
		"astro": "7.2.8",
		"sharp": "0.35.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.10",
		"agentation-review": "github:kojah/agentation-review#4516211546b8aabdad84a4285c14a7f4ff39fcb5",
		"typescript": "^6.0.3",
		"unlighthouse": "0.18.0",
		"unlighthouse-ci": "0.18.0"
	}
}
