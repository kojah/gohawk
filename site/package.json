{
	"name": "gohawk-docs",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"dev": "astro dev",
		"dev:review": "astro dev stop && agentation-review",
		"start": "astro dev",
		"generate": "go run ../tools/gendocs",
		"check": "go run ../tools/gendocs -check && biome check . && GOHAWK_ASTRO_CHECK=1 astro check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/starlight": "0.41.6",
		"@expressive-code/core": "0.44.1",
		"astro": "7.2.8",
		"sharp": "0.35.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/react": "6.0.4",
		"@biomejs/biome": "^2.5.10",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"agentation": "3.0.2",
		"agentation-review": "github:kojah/agentation-review#e0687c52e28ea8e89080eb7ee1a7be1bf174d4bd",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"typescript": "^6.0.3"
	}
}
